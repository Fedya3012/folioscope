{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folioscope",
  "version": "0.2.0",
  "identifier": "app.folioscope.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folioscope",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "resources": [
      "pdfium/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Folioscope",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NkI5Qzg5RDNGMjM5OUMKUldTY09mTFRpWnhySnYvREJCTTJOWm94Snl6dHRrOUVzL0ErU2hUR3I2d056SUJsSFg2Q1hvaUEK",
      "endpoints": [
        "https://github.com/Fedya3012/folioscope/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
